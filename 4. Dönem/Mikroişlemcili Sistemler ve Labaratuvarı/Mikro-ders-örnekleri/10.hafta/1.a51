		ORG 00H
		SJMP BASLA
		ORG 30H
BASLA: 	MOV TMOD,#00H 		;MOD 0
SAY:	MOV TL0, #18H
		MOV TH0, #0E0H
		SETB TR0 			;ZAMANLAYICI SAYMAYI BASLATIR
KONTROL:JNB TF0,KONTROL		;TIMER FLAG KONTROL EDILIR 0'SA KONTROLE GIDER tasma kontrol edilir
		INC A				;1000 sayimda bir A arttirilir
		SJMP SAY 			;SAYMAYI BASA SARAR
		END