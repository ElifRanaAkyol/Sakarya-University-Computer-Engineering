		ORG 00H
		SJMP BASLA
		ORG 30H
BASLA:	MOV TMOD, #02H ;MOD 2
		MOV TL0, #246	;TL0 SAYMAYA BASLAR TASINCA TH0DAKI DEGER BURAYA AKTARILIR
		MOV TH0, #-10 ;246 YA DENK GELIR. 
		SETB TR0 
KONTROL:JNB TF0, KONTROL
		CLR TF0
		CPL P1.0 ;HER 10 MIKROSANIYEDE BIR TOGGLE YAPARAK 20 MSANIYE PERIYOTLUK KARE SINYAL DALGASI OLUSTURULUR
		SJMP KONTROL
		END